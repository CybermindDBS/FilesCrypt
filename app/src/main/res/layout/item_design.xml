<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="?android:attr/listDivider">

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="false"
        android:clickable="true"
        android:contextClickable="true"
        android:focusable="true"
        android:scrollIndicators="none"
        android:scrollbarStyle="insideOverlay"
        android:scrollbars="vertical"
        android:splitMotionEvents="true"
        app:cardBackgroundColor="@color/background_dark_2"
        app:cardPreventCornerOverlap="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/fileSelector"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/fileThumbnail"
                    android:layout_width="42dp"
                    android:layout_height="39dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/fileImgDesc"
                    android:hapticFeedbackEnabled="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/file"
                    tools:ignore="ImageContrastCheck,RtlSymmetry" />

                <LinearLayout
                    android:id="@+id/linearLayout2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/fileThumbnail"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/filename2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="9dp"
                        android:ellipsize="middle"
                        android:hapticFeedbackEnabled="true"
                        android:longClickable="true"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp"
                        android:singleLine="true"
                        android:text="@string/filename"
                        android:textColor="@color/foreground"
                        android:textSize="17sp"
                        android:visibility="gone"
                        tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />

                    <TextView
                        android:id="@+id/filename"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="9dp"
                        android:ellipsize="middle"
                        android:fontFamily="sans-serif"
                        android:hapticFeedbackEnabled="true"
                        android:longClickable="true"
                        android:paddingTop="12dp"
                        android:singleLine="true"
                        android:text="@string/filename"
                        android:textColor="@color/foreground"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />

                    <TextView
                        android:id="@+id/itemDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="9dp"
                        android:fontFamily="sans-serif"
                        android:paddingBottom="12dp"
                        android:text="@string/str_itemDetails"
                        android:textAllCaps="false"
                        android:textColor="@color/itemDetails"
                        android:textSize="12sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <CheckBox
                android:id="@+id/fileSelector"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:buttonTint="@color/foreground"
                android:hapticFeedbackEnabled="true"
                android:includeFontPadding="false"
                android:paddingEnd="10dp"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="RtlSymmetry,SmallSp,TouchTargetSizeCheck" />

            <View
                android:id="@+id/divider3"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:backgroundTint="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>
